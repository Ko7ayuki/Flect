#include <winver.h>
#include "Version.g.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BRAND_VERSION_NUMBERS
PRODUCTVERSION BRAND_VERSION_NUMBERS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", BRAND_DESCRIPTION_TEXT
            VALUE "FileVersion", BRAND_VERSION_TEXT
            VALUE "InternalName", BRAND_FILE_TEXT
            VALUE "OriginalFilename", BRAND_FILE_TEXT
            VALUE "ProductName", BRAND_PRODUCT_TEXT
            VALUE "ProductVersion", BRAND_VERSION_TEXT
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
